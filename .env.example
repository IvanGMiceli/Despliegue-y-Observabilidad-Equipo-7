# Plantilla de variables locales: copiá este archivo como .env en la raíz.
# Compose lee .env automáticamente al ejecutar comandos desde esa carpeta.
# Estas contraseñas son para la demostración local; no las uses en un servidor público.
MYSQL_ROOT_PASSWORD=root123
# Base de datos que MySQL crea al inicializar un volumen vacío.
MYSQL_DATABASE=app_db
# Usuario de aplicación que MySQL crea para las consultas del backend.
MYSQL_USER=app_user
# Contraseña que Compose también incorpora a la URL de conexión del backend.
MYSQL_PASSWORD=app123

# --- Actividad 7 (opcional en local) ---
# DSN del proyecto en Sentry. Vacío = Sentry desactivado.
SENTRY_DSN=
# Nombre del entorno que aparece en el dashboard de Sentry.
SENTRY_ENVIRONMENT=local
